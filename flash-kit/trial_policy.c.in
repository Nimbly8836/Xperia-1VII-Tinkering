/* Local experimental restrictions around upstream SIN transport. */
#include <CommonCrypto/CommonDigest.h>
#include <stdint.h>
#include <time.h>
#include "trial_images.h"

enum trial_phase { TRIAL_READ, TRIAL_BEGIN, TRIAL_IMAGES, TRIAL_COMMIT };
static enum trial_phase trial_phase = TRIAL_READ;
static const char *trial_partition = NULL;
static unsigned trial_completed = 0;
static unsigned trial_mutations = 0;
static unsigned trial_fail_at = 0;
static unsigned trial_android_battery = 0;
static unsigned long trial_battery_observed_at = 0;
static bool trial_battery_fallback_used = false;
static bool trial_recorded_battery_accepted = false;
static unsigned long trial_pending = 0;
static unsigned long long trial_raw_bytes = 0;
enum trial_fault { FAULT_NONE, FAULT_DATA_FAIL_PREFIX, FAULT_DATA_OKAY_PREFIX, FAULT_SUPER_SLOT, FAULT_SNAPSHOT_MERGING,
                   FAULT_ROOT_SEPARATE, FAULT_ROOT_BAD_ACK, FAULT_ROOT_WRONG_HASH,
                   FAULT_BATTERY_UNSUPPORTED, FAULT_BATTERY_OTHER_FAILURE, FAULT_BATTERY_EMPTY,
                   FAULT_BATTERY_LOW, FAULT_BATTERY_MALFORMED,
                   FAULT_BATTERY_FAKE_OKAY, FAULT_BATTERY_NUL_SUFFIX };
static enum trial_fault trial_fault = FAULT_NONE;
static char trial_mock_reply[1024];
static unsigned trial_mock_root_stage = 0;
static bool trial_touched = false;
static const char *trial_root_hash = "28879FEB38A0078F6931172AFAA2D961F00C99DBAE94837553C60BE8BF0576A908CD6C5EBD2B55397419C71219FD6B53";
static const char *trial_loader_normalized = "87500001XBOOTSM8750LA10V36";

static bool trial_target(const char *target) {
    if (!trial_partition) return false;
    char slotted[80];
    snprintf(slotted, sizeof(slotted), "%s_a", trial_partition);
    return !strcmp(trial_partition,"super") ? !strcmp(target,"super") : !strcmp(target,slotted);
}

static bool trial_slot_answer_ok(const char *partition, const char *answer) {
    return trial_partition && !strcmp(partition,trial_partition) &&
        !strcmp(answer,!strcmp(partition,"super")?"no":"yes");
}

static bool trial_hex_size(const char *text) {
    if (strlen(text) != 8) return false;
    for (unsigned i = 0; i < 8; i++) if (!isxdigit((unsigned char)text[i])) return false;
    unsigned long value = strtoul(text, NULL, 16);
    return value > 0 && value <= max_download_size;
}

static bool trial_command_allowed(const char *command) {
    const char *reads[] = {"product", "serialno", "version-bootloader",
                          "secure", "Default-security", "slot-count", "current-slot",
                          "max-download-size", "Sector-size", "Battery", "snapshot-update-status", NULL};
    if (!strcmp(command,"Get-root-key-hash")) return trial_phase == TRIAL_READ;
    if (strncmp(command, "getvar:", 7) == 0) {
        for (unsigned i = 0; reads[i]; i++) if (strcmp(command + 7, reads[i]) == 0) return true;
        return (trial_phase == TRIAL_READ || trial_phase == TRIAL_IMAGES) && strncmp(command + 7, "has-slot:", 9) == 0
            && trial_partition && strcmp(command + 16, trial_partition) == 0;
    }
    if (trial_phase == TRIAL_READ) return false;
    if (trial_phase == TRIAL_BEGIN || trial_phase == TRIAL_COMMIT) {
        if (trial_phase == TRIAL_BEGIN && trial_completed != 0) return false;
        if (trial_phase == TRIAL_COMMIT && trial_completed != TRIAL_IMAGE_COUNT) return false;
        if (strcmp(command, "download:00000001") == 0 || strcmp(command, "Write-TA:2:10100") == 0) return true;
        return trial_phase == TRIAL_COMMIT &&
            (strcmp(command, "Sync") == 0 || strcmp(command, "set_active:a") == 0);
    }
    if (trial_phase != TRIAL_IMAGES || !trial_partition) return false;
    if (strncmp(command, "erase:", 6) == 0) return trial_target(command + 6);
    if (strncmp(command, "flash:", 6) == 0) return trial_target(command + 6);
    if (strcmp(command, "signature") == 0) return true;
    if (strncmp(command, "download:", 9) == 0) return trial_hex_size(command + 9);
    if (strncmp(command, "signature:", 10) == 0) return trial_hex_size(command + 10);
    return false;
}

static unsigned long trial_send_command(HANDLE device, const char *command) {
    if (!trial_command_allowed(command)) {
        fprintf(stderr, "TRIAL_DENIED_COMMAND %s\n", command);
        return 0;
    }
    printf("TRIAL_COMMAND %s\n", command);
    fflush(stdout);
    if (strncmp(command, "erase:", 6) == 0 || strncmp(command, "flash:", 6) == 0 ||
        strcmp(command, "Write-TA:2:10100") == 0 || strcmp(command, "set_active:a") == 0)
        trial_touched = true;
    return transfer_bulk_async(device, EP_OUT, (char *)command, strlen(command), USB_TIMEOUT, 1);
}

static unsigned long trial_mock_transfer(int ep, char *bytes, unsigned long size) {
    if (ep == EP_IN) {
        if (trial_mock_root_stage == 1) {
            if (size < 12) return 0;
            memcpy(bytes,"DATA00000030",12); trial_mock_root_stage=2; return 12;
        }
        if (trial_mock_root_stage == 2) {
            unsigned long count=trial_fault==FAULT_ROOT_SEPARATE?48:52;
            if (size < count) return 0;
            for (unsigned i=0;i<48;i++) {
                unsigned value=0;
                if (sscanf(trial_root_hash+2*i,"%2x",&value)!=1) return 0;
                bytes[i]=trial_fault==FAULT_ROOT_WRONG_HASH?0:(char)value;
            }
            if (count==52) memcpy(bytes+48,trial_fault==FAULT_ROOT_BAD_ACK?"FAIL":"OKAY",4);
            trial_mock_root_stage=count==48?3:0;
            return count;
        }
        if (trial_mock_root_stage == 3) {
            if (size < 4) return 0;
            memcpy(bytes,"OKAY",4);trial_mock_root_stage=0;return 4;
        }
        size_t n = strlen(trial_mock_reply);
        if (trial_fault==FAULT_BATTERY_NUL_SUFFIX && !strcmp(trial_mock_reply,"FAILBattery not supported")) {
            if (size<30) return 0;
            memcpy(bytes,"FAILBattery not supported\0junk",30);
            trial_mock_reply[0]=0;return 30;
        }
        if (!n || n > size) return 0;
        memcpy(bytes, trial_mock_reply, n);
        trial_mock_reply[0] = 0;
        return n;
    }
    if (trial_pending) {
        if (size > trial_pending) return 0;
        trial_pending -= size;
        trial_raw_bytes += size;
        if (!trial_pending) strcpy(trial_mock_reply, "OKAY");
        return size;
    }
    if (size >= 512) return 0;
    char command[512];
    memcpy(command, bytes, size); command[size] = 0;
    if (!trial_command_allowed(command)) return 0;
    if (strncmp(command, "erase:", 6) == 0 || strncmp(command, "flash:", 6) == 0 ||
        strcmp(command, "Write-TA:2:10100") == 0 || strcmp(command, "set_active:a") == 0) {
        trial_mutations++;
        if (trial_fail_at && trial_mutations == trial_fail_at) {
            strcpy(trial_mock_reply, "FAILsimulation-injected"); return size;
        }
    }
    if (!strcmp(command,"Get-root-key-hash")) {
        trial_mock_root_stage=1;
    } else if (strncmp(command, "getvar:", 7) == 0) {
        const char *key = command + 7; const char *value = NULL;
        if (!strcmp(key,"product")) value="XQ-FS72";
        else if (!strcmp(key,"serialno")) value="SIMULATION_ONLY";
        else if (!strcmp(key,"version-bootloader")) value="8750-0001_X_Boot_SM8750_LA1.0_V_36";
        else if (!strcmp(key,"secure")) value="yes";
        else if (!strcmp(key,"Default-security")) value="ON";
        else if (!strcmp(key,"slot-count")) value="2";
        else if (!strcmp(key,"current-slot")) value="b";
        else if (!strcmp(key,"max-download-size")) value="536870912";
        else if (!strcmp(key,"Sector-size")) value="4096";
        else if (!strcmp(key,"Battery")) {
            if (trial_fault==FAULT_BATTERY_UNSUPPORTED || trial_fault==FAULT_BATTERY_OTHER_FAILURE ||
                trial_fault==FAULT_BATTERY_FAKE_OKAY || trial_fault==FAULT_BATTERY_NUL_SUFFIX) {
                strcpy(trial_mock_reply,trial_fault==FAULT_BATTERY_FAKE_OKAY?"OKAYFAILBattery not supported":
                    trial_fault==FAULT_BATTERY_OTHER_FAILURE?"FAILbattery hardware error":"FAILBattery not supported");return size;
            }
            value=trial_fault==FAULT_BATTERY_EMPTY?"":trial_fault==FAULT_BATTERY_LOW?"59":
                trial_fault==FAULT_BATTERY_MALFORMED?"not-a-number":"80";
        }
        else if (!strcmp(key,"snapshot-update-status")) value=trial_fault==FAULT_SNAPSHOT_MERGING?"merging":"none";
        else if (!strncmp(key,"has-slot:",9)) value=!strcmp(key+9,"super") ? "no" : "yes";
        if (!value) return 0;
        if (trial_fault==FAULT_SUPER_SLOT && trial_phase==TRIAL_IMAGES && !strcmp(key,"has-slot:super"))
            strcpy(trial_mock_reply,"FAILslot-query");
        else snprintf(trial_mock_reply,sizeof(trial_mock_reply),"OKAY%s",value);
    } else if (!strncmp(command,"download:",9)) {
        trial_pending=strtoul(command+9,NULL,16);
        if (trial_phase==TRIAL_IMAGES && trial_fault==FAULT_DATA_FAIL_PREFIX)
            snprintf(trial_mock_reply,sizeof(trial_mock_reply),"FAIL%08lx",trial_pending);
        else if (trial_phase==TRIAL_IMAGES && trial_fault==FAULT_DATA_OKAY_PREFIX)
            snprintf(trial_mock_reply,sizeof(trial_mock_reply),"OKAYDATA%08lx",trial_pending);
        else snprintf(trial_mock_reply,sizeof(trial_mock_reply),"DATA%08lx",trial_pending);
    } else if (!strncmp(command,"signature:",10)) {
        strcpy(trial_mock_reply,"FAILuse-modern-signature");
    } else strcpy(trial_mock_reply,"OKAY");
    return size;
}

static bool trial_ok(HANDLE device, const char *command) {
    if (!trial_send_command(device, command) || !get_reply(device, EP_IN, tmp, sizeof(tmp), USB_TIMEOUT, 0)) return false;
    if (strcmp(tmp_reply,"OKAY")) { fprintf(stderr,"TRIAL_RESPONSE_FAILED %s\n",command); return false; }
    return true;
}

static bool trial_flash_mode(HANDLE device, bool entering) {
    if ((entering && trial_phase != TRIAL_BEGIN) || (!entering && trial_phase != TRIAL_COMMIT)) return false;
    if (!trial_send_command(device,"download:00000001") || !get_reply(device,EP_IN,tmp,sizeof(tmp),USB_TIMEOUT,0) || !trial_last_reply_is_data || strcmp(tmp_reply,"DATA00000001")) return false;
    char value = entering ? 1 : 0;
    if (!transfer_bulk_async(device,EP_OUT,&value,1,USB_TIMEOUT,1) || !get_reply(device,EP_IN,tmp,sizeof(tmp),USB_TIMEOUT,0) || strcmp(tmp_reply,"OKAY")) return false;
    return trial_ok(device,"Write-TA:2:10100");
}

static void trial_normalize(const char *input, char *output, size_t capacity) {
    size_t n=0;
    for (size_t i=0; input[i] && n+1<capacity; i++)
        if (isalnum((unsigned char)input[i])) output[n++]=(char)toupper((unsigned char)input[i]);
    output[n]=0;
}

static bool trial_get(HANDLE device, const char *key, char *output, size_t capacity) {
    char command[128]; snprintf(command,sizeof(command),"getvar:%s",key);
    tmp_reply[0]=0; get_reply_len=0;
    if (!trial_send_command(device,command) || !get_reply(device,EP_IN,tmp,sizeof(tmp),USB_TIMEOUT,0) ||
        !strncmp(tmp_reply,"FAIL",4) || !strcmp(tmp_reply,"OKAY") || strlen(tmp_reply)>=capacity) {
        char kind[5]="NONE";
        if (get_reply_len>=4) {
            memcpy(kind,tmp_reply,4);kind[4]=0;
            for(unsigned i=0;i<4;i++) if(!isprint((unsigned char)kind[i])) kind[i]='?';
        }
        if (!strcmp(key,"Battery")) {
            char detail[128]; size_t n=strnlen(tmp_reply,sizeof(detail)-1);
            for (size_t i=0;i<n;i++) detail[i]=isprint((unsigned char)tmp_reply[i])?tmp_reply[i]:'?';
            detail[n]=0; fprintf(stderr,"TRIAL_BATTERY_READ_DETAIL %s\n",detail);
        }
        fprintf(stderr,"TRIAL_REQUIRED_READ_FAILED %s reply_kind=%s normalized_length=%lu; no writes may start with missing state.\n",key,kind,get_reply_len); return false;
    }
    for (size_t i=0; tmp_reply[i]; i++) if ((unsigned char)tmp_reply[i]<32 || (unsigned char)tmp_reply[i]>126) return false;
    strcpy(output,tmp_reply);
    printf("TRIAL_DEVICE %s=%s\n",key,output);
    return true;
}

static bool trial_read_root_hash(HANDLE device, char *output, size_t capacity) {
    /* Sony uses a dedicated read command, then 48 binary bytes and OKAY.
       Do not use get_reply for the binary body: arbitrary hash bytes are not
       textual status prefixes. ACK may share a packet or arrive separately. */
    unsigned char response[52]; size_t used=0;
    if (capacity < 97 || !trial_send_command(device,"Get-root-key-hash") ||
        !get_reply(device,EP_IN,tmp,sizeof(tmp),USB_TIMEOUT,0) ||
        !trial_last_reply_is_data || strcmp(tmp_reply,"DATA00000030")) {
        fprintf(stderr,"TRIAL_ROOT_HASH_HEADER_REJECTED; expected Sony DATA length 48.\n");return false;
    }
    while (used < sizeof(response)) {
        unsigned long got=transfer_bulk_async(device,EP_IN,(char *)response+used,sizeof(response)-used,USB_TIMEOUT,0);
        if (!got || got>sizeof(response)-used) {
            fprintf(stderr,"TRIAL_ROOT_HASH_BODY_INCOMPLETE\n");return false;
        }
        used+=got;
    }
    if (memcmp(response+48,"OKAY",4)) {
        fprintf(stderr,"TRIAL_ROOT_HASH_ACK_REJECTED\n");return false;
    }
    for (unsigned i=0;i<48;i++) snprintf(output+2*i,3,"%02X",response[i]);
    printf("TRIAL_DEVICE root-key-hash=%s\n",output);
    return true;
}

static bool trial_uint(const char *value, unsigned long *number) {
    if (!*value || *value=='-') return false;
    char *end=NULL; errno=0; *number=strtoul(value,&end,0);
    return !errno && end && *end==0;
}

static bool trial_battery_baseline_fresh(void) {
    time_t now=time(NULL);
    return now>0 && trial_android_battery>=60 && trial_android_battery<=100 &&
        trial_battery_observed_at>0 && (unsigned long)now>=trial_battery_observed_at &&
        (trial_recorded_battery_accepted || (unsigned long)now-trial_battery_observed_at<=600);
}

static bool trial_battery_ready_to_write(void) {
    return !trial_battery_fallback_used || trial_battery_baseline_fresh();
}

static bool trial_device_check(HANDLE device, const char *expected_serial) {
    trial_battery_fallback_used=false;
    char p[64],s[128],loader[128],root[128],secured[32],default_sec[32],slots[8],active[8],maxdl[32],sector[32],battery[32],snapshot[32];
    if (!trial_get(device,"product",p,sizeof(p)) || !trial_get(device,"serialno",s,sizeof(s)) ||
        !trial_get(device,"version-bootloader",loader,sizeof(loader)) || !trial_read_root_hash(device,root,sizeof(root)) ||
        !trial_get(device,"secure",secured,sizeof(secured)) || !trial_get(device,"Default-security",default_sec,sizeof(default_sec)) ||
        !trial_get(device,"slot-count",slots,sizeof(slots)) || !trial_get(device,"current-slot",active,sizeof(active)) ||
        !trial_get(device,"max-download-size",maxdl,sizeof(maxdl)) || !trial_get(device,"Sector-size",sector,sizeof(sector))) return false;
    if (strcmp(p,"XQ-FS72") || strcmp(s,expected_serial)) {
        fprintf(stderr,"TRIAL_IDENTITY_REFUSED: battery baseline must belong to this device.\n");return false;
    }
    bool battery_ok=trial_get(device,"Battery",battery,sizeof(battery));
    /* Only the exact unsupported response observed on this Sony is eligible.
       Empty OKAY, USB failures, low/malformed readings must never fall back. */
    if (!battery_ok && trial_last_reply_is_battery_unsupported && trial_battery_baseline_fresh()) {
        trial_battery_fallback_used=true;
        snprintf(battery,sizeof(battery),"%u",trial_android_battery);
        if (trial_recorded_battery_accepted)
            printf("TRIAL_BATTERY_SOURCE=explicitly_accepted_historical_android_baseline value=%u observed_at=%lu; current_charge_not_verified\n",trial_android_battery,trial_battery_observed_at);
        else printf("TRIAL_BATTERY_SOURCE=fresh_same_device_android_baseline value=%u; max_age_seconds=600\n",trial_android_battery);
        battery_ok=true;
    }
    bool snapshot_ok=trial_get(device,"snapshot-update-status",snapshot,sizeof(snapshot));
    if (!battery_ok || !snapshot_ok) return false;
    char normalized[128],hash_normalized[128]; trial_normalize(loader,normalized,sizeof(normalized)); trial_normalize(root,hash_normalized,sizeof(hash_normalized));
    char snapshot_normalized[32]; trial_normalize(snapshot,snapshot_normalized,sizeof(snapshot_normalized));
    if (strcmp(snapshot_normalized,"NONE")) { fprintf(stderr,"TRIAL_SNAPSHOT_NOT_IDLE: do not overwrite super during an OTA snapshot/merge.\n");return false; }
    unsigned long download_size,sector_bytes,charge;
    if (strcmp(p,"XQ-FS72") || strcmp(s,expected_serial) || strcmp(normalized,trial_loader_normalized) ||
        strcmp(hash_normalized,trial_root_hash) || strcmp(secured,"yes") || strcmp(default_sec,"ON") ||
        strcmp(slots,"2") || (strcmp(active,"a") && strcmp(active,"b")) ||
        !trial_uint(maxdl,&download_size) || download_size<TRIAL_MAX_MEMBER || download_size>1024UL*1024*1024 ||
        !trial_uint(sector,&sector_bytes) || sector_bytes!=4096 || !trial_uint(battery,&charge) || charge<60 || charge>100) {
        fprintf(stderr,"TRIAL_DEVICE_GUARD_FAILED: no writes permitted; review the reported values.\n"); return false;
    }
    for (unsigned i=0;i<TRIAL_IMAGE_COUNT;i++) {
        char key[100],answer[16]; trial_partition=trial_images[i].partition;
        snprintf(key,sizeof(key),"has-slot:%s",trial_partition);
        const char *expected=!strcmp(trial_partition,"super")?"no":"yes";
        if (!trial_get(device,key,answer,sizeof(answer)) || strcmp(answer,expected)) {
            fprintf(stderr,"TRIAL_SLOT_LAYOUT_REFUSED %s\n",trial_partition); return false;
        }
    }
    trial_partition=NULL;
    max_download_size=(unsigned int)download_size;
    strcpy(current_slot,"a");
    is_2021_device=true;
    printf("TRIAL_TARGET_SLOT=a; ORIGINAL_SLOT=%s; BOOTLOADER_PRESERVED\n",active);
    return true;
}
