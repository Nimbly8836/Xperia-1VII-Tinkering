# Public-source allowlist: keep private research and device evidence local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/flash-kit/
!/firmware-downloads/
!/scripts/
!/docs/

/flash-kit/*
!/flash-kit/.gitignore
!/flash-kit/*.py
!/flash-kit/*.c.in
!/flash-kit/bundle_start.py.in
!/flash-kit/README.md
!/flash-kit/TRIAL.md
!/flash-kit/pyrightconfig.json
!/flash-kit/upstream/
/flash-kit/upstream/*
!/flash-kit/upstream/newflasher-59f12e4.c.txt

/firmware-downloads/*
!/firmware-downloads/.gitignore
!/firmware-downloads/download_official.py
!/firmware-downloads/README.md

# Only reviewed public files belong in these directories.
/scripts/*
!/scripts/switch_sim.py
!/scripts/test_switch_sim.py
!/scripts/70-xperia-flash.rules
!/scripts/test_termux_widget.py
!/scripts/termux-widget/
/scripts/termux-widget/*
!/scripts/termux-widget/enable-esim.sh
!/scripts/termux-widget/enable-dual-sim.sh
/docs/*
!/docs/verified-results.md
!/docs/termux-widget.md
!/docs/linux.md
!/docs/distribution.md
!/docs/firmware-71.2.A.2.35-research.md
!/docs/upgrade-preparation.md
!/docs/upgrade-boot-findings.md
!/docs/upgrade-official-path.md
!/docs/upgrade-esim-findings.md

# Defense in depth: firmware, proprietary extracts, credentials and outputs.
**/__pycache__/
**/.venv/
**/.ruff_cache/
**/.DS_Store
**/.env
**/.env.*
*.pyc
*.log
*.partial
*.zip
*.sin
*.img
*.elf
*.mbn
*.apk
*.dex
*.jar
*.so
*.exe
*.pem
*.key
**/build/
**/metadata/
**/packages/
**/candidate-*/
